#!/usr/bin/env bash
# BrawlBot project generator — creates a full Android Studio project.
set -e
ROOT="BrawlBot"
mkdir -p "$ROOT/app/src/main/java/com/eni/brawlbot"
mkdir -p "$ROOT/app/src/main/res/xml"
mkdir -p "$ROOT/app/src/main/res/values"
mkdir -p "$ROOT/gradle/wrapper"

# ---------- settings.gradle ----------
cat > "$ROOT/settings.gradle" <<'EOF'
pluginManagement { repositories { google(); mavenCentral(); gradlePluginPortal() } }
dependencyResolutionManagement { repositories { google(); mavenCentral() } }
rootProject.name = "BrawlBot"
include ':app'
EOF

# ---------- build.gradle (root) ----------
cat > "$ROOT/build.gradle" <<'EOF'
plugins {
    id 'com.android.application' version '8.2.0' apply false
}
EOF

# ---------- gradle.properties ----------
cat > "$ROOT/gradle.properties" <<'EOF'
android.useAndroidX=true
org.gradle.jvmargs=-Xmx2048m
EOF

# ---------- app/build.gradle ----------
cat > "$ROOT/app/build.gradle" <<'EOF'
plugins { id 'com.android.application' }

android {
    namespace 'com.eni.brawlbot'
    compileSdk 34
    defaultConfig {
        applicationId "com.eni.brawlbot"
        minSdk 24
        targetSdk 34
        versionCode 1
        versionName "1.0"
    }
    buildTypes {
        release { minifyEnabled false }
    }
    compileOptions {
        sourceCompatibility JavaVersion.VERSION_17
        targetCompatibility JavaVersion.VERSION_17
    }
}
EOF

