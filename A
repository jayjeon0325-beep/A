cat > "$ROOT/app/src/main/java/com/eni/brawlbot/ScreenCapture.java" <<'EOF'
package com.eni.brawlbot;

import android.graphics.Bitmap;
import android.graphics.PixelFormat;
import android.hardware.display.DisplayManager;
import android.hardware.display.VirtualDisplay;
import android.media.Image;
import android.media.ImageReader;
import android.media.projection.MediaProjection;
import android.util.DisplayMetrics;
import java.nio.ByteBuffer;

public class ScreenCapture {
    private MediaProjection projection;
    private VirtualDisplay display;
    private ImageReader reader;
    private int width, height, dpi;

    public ScreenCapture(MediaProjection projection, DisplayMetrics m) {
        this.projection = projection;
        this.width = m.widthPixels;
        this.height = m.heightPixels;
        this.dpi = m.densityDpi;
        reader = ImageReader.newInstance(width, height, PixelFormat.RGBA_8888, 2);
        display = projection.createVirtualDisplay(
                "BrawlCap", width, height, dpi,
                DisplayManager.VIRTUAL_DISPLAY_FLAG_AUTO_MIRROR,
                reader.getSurface(), null, null);
    }

    public Bitmap capture() {
        Image img = reader.acquireLatestImage();
        if (img == null) return null;
        Image.Plane plane = img.getPlanes()[0];
        ByteBuffer buf = plane.getBuffer();
        int pixelStride = plane.getPixelStride();
        int rowStride = plane.getRowStride();
        int rowPadding = rowStride - pixelStride * width;
        Bitmap bmp = Bitmap.createBitmap(width + rowPadding / pixelStride, height,
                Bitmap.Config.ARGB_8888);
        bmp.copyPixelsFromBuffer(buf);
        img.close();
        return bmp;
    }

    public int pixelAt(Bitmap bmp, int x, int y) {
        if (x < 0 || y < 0 || x >= bmp.getWidth() || y >= bmp.getHeight()) return 0;
        return bmp.getPixel(x, y);
    }

    public void stop() {
        if (display != null) display.release();
        if (reader != null) reader.close();
    }
}
EOF

# ---------- BotService.java ----------
cat > "$ROOT/app/src/main/java/com/eni/brawlbot/BotService.java" <<'EOF'
package com.eni.brawlbot;

import android.app.Notification;
import android.app.NotificationChannel;
import android.app.NotificationManager;
import android.app.Service;
import android.content.Intent;
import android.graphics.Bitmap;
import android.media.projection.MediaProjection;
import android.os.Build;
import android.os.IBinder;
import android.util.DisplayMetrics;
import java.util.Random;

public class BotService extends Service {
    private ScreenCapture cap;
    private Thread worker;
    private volatile boolean running = true;
    private final Random rnd = new Random();

    private final int[] PLAY_BTN   = {540, 1600};
    private final int[] ATTACK_BTN = {900, 1650};
    private final int[] SUPER_BTN  = {820, 1500};
    private final int[] JOYSTICK   = {220, 1650};
    private final int[] SIG_HP     = {900, 900};
    private final int[] SIG_RESULT = {540, 800};
    private final int[] CLAIM_BTN  = {540, 1700};
    private final int[] BACK_BTN   = {540, 1850};
    private final int[] EVENT_TILE = {540, 700};
    private final int[] BRAWLER_SL = {300, 1100};
    private final int[] SELECT_BTN = {540, 1750};

    private final int COLOR_HP   = 0xFFE63C3C;
    private final int COLOR_WIN  = 0xFF3C78DC;
    private final int COLOR_LOSS = 0xFFC83232;

    @Override
    public int onStartCommand(Intent intent, int flags, int startId) {
        startForeground(1, buildNotification());
        MediaProjection proj = (MediaProjection)
                intent.getParcelableExtra("projection");
        DisplayMetrics dm = getResources().getDisplayMetrics();
        cap = new ScreenCapture(proj, dm);
        worker = new Thread(this::loop);
        worker.start();
        return START_STICKY;
    }

    private Notification buildNotification() {
        String ch = "brawlbot";
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            NotificationChannel nc = new NotificationChannel(ch,
                    "BrawlBot", NotificationManager.IMPORTANCE_LOW);
            ((NotificationManager) getSystemService(NOTIFICATION_SERVICE))
                    .createNotificationChannel(nc);
        }
        Notification.Builder b = (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O)
                ? new Notification.Builder(this, ch)
                : new Notification.Builder(this);
        return b.setContentTitle("BrawlBot running")
                .setContentText("Auto-play active")
                .setSmallIcon(android.R.drawable.ic_menu_compass)
                .build();
    }

    private boolean near(int c1, int c2, int tol) {
        int r1 = (c1 >> 16) & 0xFF, g1 = (c1 >> 8) & 0xFF, b1 = c1 & 0xFF;
        int r2 = (c2 >> 16) & 0xFF, g2 = (c2 >> 8) & 0xFF, b2 = c2 & 0xFF;
        return Math.abs(r1 - r2) < tol && Math.abs(g1 - g2) < tol
                && Math.abs(b1 - b2) < tol;
    }

    private void tap(int[] pt, int jitter) {
        float x = pt[0] + rnd.nextInt(jitter * 2) - jitter;
        float y = pt[1] + rnd.nextInt(jitter * 2) - jitter;
        AutoTouchService.tap(x, y);
    }

    private void loop() {
        while (running) {
            try {
                Bitmap bmp = cap.capture();
                if (bmp == null) { Thread.sleep(80); continue; }
                int hp  = cap.pixelAt(bmp, SIG_HP[0], SIG_HP[1]);
                int res = cap.pixelAt(bmp, SIG_RESULT[0], SIG_RESULT[1]);
                bmp.recycle();

                if (near(hp, COLOR_HP, 40)) {
                    runMatch();
                } else if (near(res, COLOR_WIN, 45) || near(res, COLOR_LOSS, 45)) {
                    tap(CLAIM_BTN, 8); Thread.sleep(1200);
                    tap(CLAIM_BTN, 8); Thread.sleep(1200);
                    tap(BACK_BTN, 8);  Thread.sleep(1500);
                } else {
                    tap(PLAY_BTN, 10);   Thread.sleep(1400);
                    tap(PLAY_BTN, 10);   Thread.sleep(1400);
                    tap(EVENT_TILE, 10); Thread.sleep(1200);
                    tap(BRAWLER_SL, 10); Thread.sleep(600);
                    tap(SELECT_BTN, 10); Thread.sleep(1500);
                }
            } catch (Exception e) {
                try { Thread.sleep(1000); } catch (Exception ignored) {}
            }
        }
    }

    private void runMatch() throws InterruptedException {
        long start = System.currentTimeMillis();
        double angle = 0;
        while (System.currentTimeMillis() - start < 200_000) {
            Bitmap bmp = cap.capture();
            if (bmp != null) {
                int res = cap.pixelAt(bmp, SIG_RESULT[0], SIG_RESULT[1]);
                bmp.recycle();
                if (near(res, COLOR_WIN, 45) || near(res, COLOR_LOSS, 45)) return;
            }
            angle += 0.3 + rnd.nextDouble() * 0.3;
            int r = 55 + rnd.nextInt(15);
            float dx = (float) Math.cos(angle) * r;
            float dy = (float) Math.sin(angle) * r;
            AutoTouchService.swipe(JOYSTICK[0], JOYSTICK[1],
                    JOYSTICK[0] + dx, JOYSTICK[1] + dy, 140);
            tap(ATTACK_BTN, 18);
            if (rnd.nextDouble() < 0.18) tap(SUPER_BTN, 12);
            Thread.sleep(120 + rnd.nextInt(200));
        }
    }

    @Override public void onDestroy() {
        running = false;
        if (cap != null) cap.stop();
        super.onDestroy();
    }

    @Override public IBinder onBind(Intent i) { return null; }
}
