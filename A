# ---------- MainActivity.java ----------
cat > "$ROOT/app/src/main/java/com/eni/brawlbot/MainActivity.java" <<'EOF'
package com.eni.brawlbot;

import android.app.Activity;
import android.content.Intent;
import android.media.projection.MediaProjectionManager;
import android.os.Bundle;
import android.provider.Settings;
import android.widget.Button;
import android.widget.LinearLayout;
import android.widget.Toast;

public class MainActivity extends Activity {
    private static final int REQ_PROJ = 1001;
    private MediaProjectionManager mpManager;

    @Override protected void onCreate(Bundle b) {
        super.onCreate(b);
        LinearLayout ll = new LinearLayout(this);
        ll.setOrientation(LinearLayout.VERTICAL);
        ll.setPadding(40, 80, 40, 40);

        Button accBtn = new Button(this);
        accBtn.setText("1. Enable Accessibility Service");
        accBtn.setOnClickListener(v ->
            startActivity(new Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS)));
        ll.addView(accBtn);

        Button startBtn = new Button(this);
        startBtn.setText("2. Start Bot (grants screen capture)");
        startBtn.setOnClickListener(v -> {
            mpManager = (MediaProjectionManager)
                    getSystemService(MEDIA_PROJECTION_SERVICE);
            startActivityForResult(mpManager.createScreenCaptureIntent(), REQ_PROJ);
        });
        ll.addView(startBtn);

        setContentView(ll);
    }

    @Override protected void onActivityResult(int req, int res, Intent data) {
        if (req == REQ_PROJ && res == RESULT_OK) {
            Intent svc = new Intent(this, BotService.class);
            svc.putExtra("projection", mpManager.getMediaProjection(res, data));
            startForegroundService(svc);
            Toast.makeText(this, "Bot started", Toast.LENGTH_SHORT).show();
        }
    }
}
EOF

# ---------- AutoTouchService.java ----------
cat > "$ROOT/app/src/main/java/com/eni/brawlbot/AutoTouchService.java" <<'EOF'
package com.eni.brawlbot;

import android.accessibilityservice.AccessibilityService;
import android.accessibilityservice.GestureDescription;
import android.graphics.Path;
import android.view.accessibility.AccessibilityEvent;

public class AutoTouchService extends AccessibilityService {
    private static AutoTouchService instance;

    @Override public void onServiceConnected() { instance = this; }
    public static AutoTouchService get() { return instance; }

    public static void tap(float x, float y) {
        if (instance == null) return;
        Path p = new Path();
        p.moveTo(x, y);
        GestureDescription.StrokeDescription s =
                new GestureDescription.StrokeDescription(p, 0, 60);
        instance.dispatchGesture(
                new GestureDescription.Builder().addStroke(s).build(), null, null);
    }

    public static void swipe(float x1, float y1, float x2, float y2, long ms) {
        if (instance == null) return;
        Path p = new Path();
        p.moveTo(x1, y1);
        p.lineTo(x2, y2);
        GestureDescription.StrokeDescription s =
                new GestureDescription.StrokeDescription(p, 0, ms);
        instance.dispatchGesture(
                new GestureDescription.Builder().addStroke(s).build(), null, null);
    }

    @Override public void onAccessibilityEvent(AccessibilityEvent e) {}
    @Override public void onInterrupt() {}
}
EOF

